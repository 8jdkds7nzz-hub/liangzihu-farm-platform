FROM node:22.15.0-bookworm-slim@sha256:557e52a0fcb928ee113df7e1fb5d4f60c1341dbda53f55e3d815ca10807efdce
ARG DEBIAN_MIRROR=official
RUN DEBIAN_MIRROR="$DEBIAN_MIRROR" node -e 'const fs=require("fs"),mode=process.env.DEBIAN_MIRROR;if(!["official","tuna"].includes(mode))throw Error("INVALID_MIRROR");if(mode==="tuna"){fs.mkdirSync("/etc/ssl/certs",{recursive:true});if(!fs.existsSync("/etc/ssl/certs/ca-certificates.crt"))fs.writeFileSync("/etc/ssl/certs/ca-certificates.crt",require("tls").rootCertificates.join("\n"));const p="/etc/apt/sources.list.d/debian.sources";fs.writeFileSync(p,fs.readFileSync(p,"utf8").replaceAll("http://deb.debian.org","https://mirrors.tuna.tsinghua.edu.cn"));}' \
    && printf 'Acquire::Retries "2";\nAcquire::http::Timeout "30";\nAcquire::https::Timeout "30";\nAcquire::http::Pipeline-Depth "0";\n' > /etc/apt/apt.conf.d/99quality-network \
    && apt-get update && apt-get install -y --no-install-recommends docker.io python3 procps git ca-certificates && rm -rf /var/lib/apt/lists/*
RUN npm install --global pnpm@10.33.0
WORKDIR /workspace

{
  "name": "liangzihu-farm-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:db": "node --env-file=.env.test.local --import tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "test": "pnpm test:unit && pnpm test:db",
    "test:http": "node --env-file=.env.test.local --import tsx --test tests/acceptance/identity-http.test.ts",
    "identity:setup": "node --import tsx tools/setup-identity.ts",
    "registry:setup": "node --env-file=.env.local --import tsx tools/setup-registry.ts",
    "worker:ingest": "node --env-file=.env.local --import tsx workers/ingest.ts",
    "worker:alarms": "node --env-file=.env.local --import tsx workers/alarms.ts",
    "worker:notifications": "node --env-file=.env.local --import tsx workers/notifications.ts",
    "ops:setup": "node tools/setup-operations.mjs",
    "ops:health": "node --env-file=.env.health.local ops/external-health.mjs",
    "test:monitor": "node --test tests/acceptance/external-health.test.mjs",
    "ops:restore-drill": "node --env-file=.env.test.local --import tsx ops/restore-check.ts",
    "test:compat": "node --env-file=.env.test.local --import tsx --test tests/acceptance/migration-compat.test.ts",
    "test:browser": "node --env-file=.env.test.local --import tsx --test tests/acceptance/platform-browser.test.ts",
    "test:health": "node --env-file=.env.test.local --import tsx --test tests/acceptance/health-http.test.ts",
    "db:setup": "node tools/setup-local-db.mjs",
    "db:migrate": "node --env-file=.env.local --import tsx src/db/migrate.ts",
    "db:status": "node --env-file=.env.local --import tsx src/db/migrate.ts --status"
  },
  "dependencies": {
    "next": "16.3.8",
    "otplib": "13.5.0",
    "pg": "8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "playwright": "1.62.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}

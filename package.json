{
  "name": "liangzihu-farm-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:db": "node --env-file=.env.test.local --import tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "test": "pnpm test:unit && pnpm test:db",
    "db:setup": "node tools/setup-local-db.mjs",
    "db:migrate": "node --env-file=.env.local --import tsx src/db/migrate.ts",
    "db:status": "node --env-file=.env.local --import tsx src/db/migrate.ts --status"
  },
  "dependencies": {
    "next": "16.3.8",
    "pg": "8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}

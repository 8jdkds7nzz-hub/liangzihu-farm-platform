# pnpm db:setup creates local development and test credentials in ignored files.
DATABASE_URL=postgresql://agri_developer:replace-locally@127.0.0.1:55432/agri_dev
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=3000
DB_STATEMENT_TIMEOUT_MS=10000
# Keep TEST_DATABASE_URL in .env.test.local, not this development file.
# TEST_DATABASE_URL must name the isolated agri_test database.
# pnpm identity:setup generates this key in .env.local. Never commit a real key.
# IDENTITY_ENCRYPTION_KEY=<64 lowercase hex characters, independent of database passwords>
APP_ORIGIN=http://127.0.0.1:3100
# Set 0 for password-only login; omitted or 1 keeps the existing MFA policy.
IDENTITY_MFA_REQUIRED=1
# Public deployments must use one exact HTTPS origin; request headers cannot override it.
# pnpm ops:setup generates HEALTHCHECK_TOKEN and a separate .env.health.local.
# Live external health alerts remain disabled until a channel and recipients are approved.

# Private media. Local backup is a second directory, not production disaster recovery.
MEDIA_DRIVER=local
# MEDIA_ROOT=/absolute/private/media
# MEDIA_BACKUP_ROOT=/absolute/private/backup
# MEDIA_DRIVER=s3 requires private original and backup buckets with separate names.
# MEDIA_BUCKET=
# MEDIA_BACKUP_BUCKET=
# MEDIA_S3_REGION=
# MEDIA_S3_ENDPOINT=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Fixed models and permissions must be verified for the actual account before enabling.
MODEL_EXTERNAL_ENABLED=0
# MOONSHOT_API_KEY=
# MOONSHOT_MODEL=
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=
# MODEL_CACHE_ROOT=/absolute/private/models

# Read-only QWeather daily forecast client. Default off; no real requests in tests.
QWEATHER_READS_ENABLED=0
# QWEATHER_KEY_ID=
# QWEATHER_DEVELOPER_ID=
# QWEATHER_PROJECT_ID=
# QWEATHER_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# WEATHER_DB_POOL_MAX=2

# Read-only transfer of already authorized plaintext media links. Default off.
MEDIA_REMOTE_READS_ENABLED=0
# Exact verified HTTPS CDN hosts, comma-separated; no wildcard or IP addresses.
# MEDIA_IMPORT_ALLOWED_HOSTS=

# Phase 1 read-only integrations: flags remain off until actual contracts are verified.
WECOM_ENABLED=0
WECOM_CONTRACT_VERIFIED=0
# WECOM_CORP_ID=
# WECOM_APP_SECRET=
# WECOM_AGENT_ID=
# WECOM_EVIDENCE=
# WECOM_USERINFO_CONTRACT=sdk-legacy (or verified-modern after G03 verification)
NOTICE_EXTERNAL_ENABLED=0
VOICE_ENABLED=0
VOICE_CONTRACT_VERIFIED=0
# VOICE_CONTRACT_EVIDENCE=
# VOICE_TEMPLATE_CODE=
# VOICE_TEXT_VARIABLE=
# VOICE_PRODUCT_ID=
# VOICE_CALLER_NUMBER=
SMS_ENABLED=0
SMS_CONTRACT_VERIFIED=0
SMS_DAILY_LIMIT=200
# SMS_CONTRACT_EVIDENCE=
# SMS_SIGN_NAME=
# SMS_TEMPLATE_CODE=
# SMS_CODE_VARIABLE=
# ALIBABA_CLOUD_ACCESS_KEY_ID=
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# ALIBABA_CLOUD_SECURITY_TOKEN=
RENKE_HTTP_ENABLED=0
CAMERA_READS_ENABLED=0
# EZVIZ_ACCESS_TOKEN_<VERIFIED_ACCOUNT>=
# Large originals: default 2 GiB, configurable up to 10 GiB; real capacity requires a drill.
MEDIA_MAX_UPLOAD_BYTES=2147483648
# Production archive variables are configured on a dedicated cluster, never activated here.
# WAL_ARCHIVE_ROOT=/var/lib/agri-backup
# BACKUP_CLUSTER_ID=

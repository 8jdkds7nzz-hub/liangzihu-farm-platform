# pnpm db:setup creates local development and test credentials in ignored files.
DATABASE_URL=postgresql://agri_developer:replace-locally@127.0.0.1:55432/agri_dev
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=3000
DB_STATEMENT_TIMEOUT_MS=10000
# Keep TEST_DATABASE_URL in .env.test.local, not this development file.
# TEST_DATABASE_URL must name the isolated agri_test database.
# pnpm identity:setup generates this key in .env.local. Never commit a real key.
# IDENTITY_ENCRYPTION_KEY=<64 lowercase hex characters, independent of database passwords>
APP_ORIGIN=http://127.0.0.1:3100
# Public deployments must use one exact HTTPS origin; request headers cannot override it.
# pnpm ops:setup generates HEALTHCHECK_TOKEN and a separate .env.health.local.
# Live external health alerts remain disabled until a channel and recipients are approved.
